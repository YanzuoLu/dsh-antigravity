{
  "name": "dsh-antigravity",
  "version": "0.1.0",
  "description": "Single-account Antigravity provider for DeepSeek Harness, without extra tools",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "lib", "dist", "cordis.patch.yml", "UPSTREAM.md"],
  "license": "MIT",
  "author": "Yanzuo Lu",
  "repository": { "type": "git", "url": "https://github.com/YanzuoLu/dsh-antigravity.git" },
  "scripts": { "build": "node scripts/build.mjs" },
  "engines": { "node": ">=22.15" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-primitives"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@earendil-works/pi-ai": "0.87.1",
    "zod": "^4.0.0"
  },
  "devDependencies": { "esbuild": "0.25.12" }
}
